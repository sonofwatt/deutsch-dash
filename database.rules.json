{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$code": {
        ".read": "auth != null",
        "meta": {
          ".write": "auth != null",
          "hostId": {
            ".validate": "newData.isString() && (root.child('rooms').child($code).child('players').child(newData.val()).exists() || !root.child('rooms').child($code).child('players').exists()) && !root.child('rooms').child($code).child('players').child(newData.val()).child('isBot').exists()"
          },
          "playerCount": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 8 && (!data.exists() || newData.val() >= data.val())"
          },
          "creatorId": {
            ".validate": "newData.isString() && (root.child('rooms').child($code).child('players').child(newData.val()).exists() || !root.child('rooms').child($code).child('players').exists()) && !root.child('rooms').child($code).child('players').child(newData.val()).child('isBot').exists()"
          },
          "createdAt": {
            ".validate": "newData.isNumber() && !data.exists()"
          },
          "phase": {
            ".validate": "newData.val().matches(/^(lobby|playing|roundEnd|gameOver)$/)"
          },
          "targetScore": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 1000"
          },
          "roundNumber": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000"
          },
          "countdown": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10"
          },
          "hintsOn": {
            ".validate": "newData.isBoolean()"
          },
          "orderlyGrid": {
            ".validate": "newData.isBoolean()"
          },
          "flingOn": {
            ".validate": "newData.isBoolean()"
          },
          "singleFlip": {
            ".validate": "newData.isBoolean()"
          },
          "paleCards": {
            ".validate": "newData.isBoolean()"
          }
        },
        "players": {
          "$uid": {
            ".write": "auth != null && (auth.uid === $uid || root.child('rooms').child($code).child('meta').child('hostId').val() === auth.uid)",
            "name": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 32"
            },
            "badgeId": {
              ".validate": "newData.val().matches(/^(tulip|clover|star|bell|clownfish|anchor|acorn|boat|bicycle|kite)$/)"
            },
            "joinedAt": {
              ".validate": "newData.isNumber()"
            },
            "stuckAt": {
              ".validate": "newData.isNumber()"
            },
            "awayAt": {
              ".validate": "newData.isNumber()"
            },
            "score": {
              ".validate": "newData.isNumber() && newData.val() >= -100000 && newData.val() <= 100000"
            },
            "connected": {
              ".validate": "newData.isBoolean()"
            },
            "ready": {
              ".validate": "newData.isBoolean()"
            },
            "sittingOut": {
              ".validate": "newData.isBoolean()"
            },
            "isBot": {
              ".validate": "newData.val() === true && $uid.matches(/^bot_/)"
            },
            "botLevel": {
              ".validate": "newData.val().matches(/^(easy|medium|hard|genius)$/)"
            }
          }
        },
        "badges": {
          "$badgeId": {
            ".write": "auth != null",
            ".validate": "$badgeId.matches(/^(tulip|clover|star|bell|clownfish|anchor|acorn|boat|bicycle|kite)$/) && newData.isString() && newData.val() === auth.uid && (!data.exists() || data.val() === auth.uid)"
          }
        },
        "stats": {
          ".write": "auth != null && root.child('rooms').child($code).child('meta').child('hostId').val() === auth.uid"
        },
        "round": {
          "spaces": {
            ".write": "auth != null",
            "$i": {
              ".validate": "$i.matches(/^([0-9]|[1-2][0-9]|3[01])$/)",
              "suit": {
                ".validate": "newData.val().matches(/^(red|blue|green|yellow)$/)"
              },
              "stack": {
                "$j": {
                  ".validate": "$j.matches(/^[0-9]$/) && newData.hasChildren(['v', 'suit', 'owner'])",
                  "v": {
                    ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 10"
                  },
                  "suit": {
                    ".validate": "newData.val().matches(/^(red|blue|green|yellow)$/)"
                  },
                  "owner": {
                    ".validate": "newData.isString() && newData.val().length <= 64"
                  }
                }
              },
              "history": {
                "$k": {
                  ".validate": "$k.matches(/^([0-9]|[1-5][0-9]|6[0-3])$/) && newData.hasChildren()",
                  "$j": {
                    ".validate": "$j.matches(/^[0-9]$/) && newData.hasChildren(['v', 'suit', 'owner'])",
                    "v": {
                      ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 10"
                    },
                    "suit": {
                      ".validate": "newData.val().matches(/^(red|blue|green|yellow)$/)"
                    },
                    "owner": {
                      ".validate": "newData.isString() && newData.val().length <= 64"
                    }
                  }
                }
              }
            }
          },
          "dashedBy": {
            ".write": "auth != null",
            ".validate": "newData.isString() && newData.val().length <= 64"
          },
          "races": {
            ".write": "auth != null",
            "$space": {
              ".validate": "$space.matches(/^([0-9]|[1-2][0-9]|3[01])$/) && newData.hasChildren(['by', 'at'])",
              "by": {
                ".validate": "newData.isString() && newData.val().length <= 64"
              },
              "at": {
                ".validate": "newData.isNumber()"
              }
            }
          },
          "duels": {
            ".write": "auth != null",
            "$loser": {
              "$winner": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000"
              }
            }
          },
          "stuckRounds": {
            ".write": "auth != null",
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000"
          },
          ".write": "auth != null && root.child('rooms').child($code).child('meta').child('hostId').val() === auth.uid",
          "tableaus": {
            "$uid": {
              ".write": "auth != null && (auth.uid === $uid || root.child('rooms').child($code).child('meta').child('hostId').val() === auth.uid)",
              "dash": {
                "$i": {
                  ".validate": "$i.matches(/^([0-9]|[1-3][0-9])$/) && newData.hasChildren(['v', 'suit', 'owner']) && newData.child('owner').val() === $uid",
                  "v": {
                    ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 10"
                  },
                  "suit": {
                    ".validate": "newData.val().matches(/^(red|blue|green|yellow)$/)"
                  },
                  "owner": {
                    ".validate": "newData.isString() && newData.val().length <= 64"
                  }
                }
              },
              "wood": {
                "$i": {
                  ".validate": "$i.matches(/^([0-9]|[1-3][0-9])$/) && newData.hasChildren(['v', 'suit', 'owner']) && newData.child('owner').val() === $uid",
                  "v": {
                    ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 10"
                  },
                  "suit": {
                    ".validate": "newData.val().matches(/^(red|blue|green|yellow)$/)"
                  },
                  "owner": {
                    ".validate": "newData.isString() && newData.val().length <= 64"
                  }
                }
              },
              "post": {
                "$p": {
                  ".validate": "$p.matches(/^[0-4]$/)",
                  "$i": {
                    ".validate": "$i.matches(/^([0-9]|[1-3][0-9])$/) && newData.hasChildren(['v', 'suit', 'owner']) && newData.child('owner').val() === $uid",
                    "v": {
                      ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 10"
                    },
                    "suit": {
                      ".validate": "newData.val().matches(/^(red|blue|green|yellow)$/)"
                    },
                    "owner": {
                      ".validate": "newData.isString() && newData.val().length <= 64"
                    }
                  }
                }
              },
              "woodIndex": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 40"
              }
            }
          },
          "scores": {
            "$uid": {
              ".validate": "newData.hasChildren(['centerCount', 'dashLeft', 'delta'])",
              "centerCount": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 400"
              },
              "dashLeft": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 40"
              },
              "delta": {
                ".validate": "newData.isNumber() && newData.val() >= -100 && newData.val() <= 400"
              }
            }
          },
          "startedAt": {
            ".validate": "newData.isNumber()"
          },
          "endedAt": {
            ".validate": "newData.isNumber()"
          },
          "spaceCount": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 32"
          },
          "postCount": {
            ".validate": "newData.val() === 3 || newData.val() === 5"
          },
          "seats": {
            "$i": {
              ".validate": "$i.matches(/^[0-7]$/) && newData.isString() && newData.val().length <= 64"
            }
          }
        }
      }
    }
  }
}
