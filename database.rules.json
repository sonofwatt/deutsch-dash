{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$code": {
        ".read": "auth != null",
        "meta": {
          ".write": "auth != null",
          "hostId": {
            ".validate": "root.child('rooms').child($code).child('players').child(newData.val()).exists() || !root.child('rooms').child($code).child('players').exists()"
          },
          "playerCount": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 8 && (!data.exists() || newData.val() >= data.val())"
          }
        },
        "players": {
          "$uid": {
            ".write": "auth != null && (auth.uid === $uid || root.child('rooms').child($code).child('meta').child('hostId').val() === auth.uid)",
            ".validate": "data.exists() || root.child('rooms').child($code).child('meta').child('phase').val() === 'lobby'"
          }
        },
        "badges": {
          "$badgeId": {
            ".write": "auth != null",
            ".validate": "newData.isString() && newData.val() === auth.uid && (!data.exists() || data.val() === auth.uid)"
          }
        },
        "round": {
          "spaces": { ".write": "auth != null" },
          "blitzedBy": { ".write": "auth != null" },
          "scores": { ".write": "auth != null" },
          "stuckRounds": { ".write": "auth != null" },
          "startedAt": { ".write": "auth != null" },
          ".write": "auth != null && root.child('rooms').child($code).child('meta').child('hostId').val() === auth.uid",
          "tableaus": {
            "$uid": {
              ".write": "auth != null && (auth.uid === $uid || root.child('rooms').child($code).child('meta').child('hostId').val() === auth.uid)"
            }
          }
        }
      }
    }
  }
}
