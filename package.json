{
  "name": "deutsch-dash",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:emu": "node scripts/with-java.mjs firebase emulators:exec --only database,auth --project demo-blitz \"cross-env EMULATOR=1 vitest run\"",
    "emu": "node scripts/with-java.mjs firebase emulators:start --only database,auth --project demo-blitz",
    "test:layout": "cross-env LAYOUT=1 vitest run"
  },
  "dependencies": {
    "firebase": "^12.18.0",
    "framer-motion": "^13.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "cross-env": "^10.1.0",
    "firebase-tools": "^15.28.1",
    "oxlint": "^1.75.0",
    "playwright": "^1.62.1",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.11"
  }
}
